{{- if default false (get . "omarchy") -}}
{{- $desktop := default (dict) (get . "omarchy_desktop") -}}
#!/bin/bash
# Omarchy keeps the theme, the text size and the set of web apps as state its
# own commands write (~/.local/state/omarchy, shell.toml, the terminal configs,
# ~/.local/share/applications), so they are applied with those commands rather
# than as files. Declared in home/.chezmoidata/omarchy.yaml; this re-runs when
# that file changes and only acts on what differs, so a re-run changes nothing.
# Declared: {{ $desktop | toJson }}
set -euo pipefail

if ! command -v omarchy >/dev/null 2>&1; then
    echo "omarchy command not found; leaving the Omarchy desktop state alone." >&2
    exit 0
fi

state_dir="$HOME/.local/state/omarchy"

# Theme. `omarchy theme set` restarts the shell and reloads Hyprland, so it
# needs the Hyprland session that owns them.
theme={{ default "" (get $desktop "theme") | quote }}
if [ -n "$theme" ]; then
    current_theme="$(cat "$state_dir/current/theme.name" 2>/dev/null || true)"
    if [ "$current_theme" = "$theme" ]; then
        echo "Omarchy theme already $theme."
    elif [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && ! pgrep -x Hyprland >/dev/null 2>&1; then
        echo "No Hyprland session; run 'omarchy theme set $theme' from the desktop to apply the theme." >&2
    else
        omarchy theme set "$theme"
        echo "Omarchy theme set to $theme."
    fi
fi

# Text size: shell font base-size (12 when unset), GTK text scale and terminal
# point size together. Reading the base-size mirrors omarchy-display-text-size.
text_size={{ default "" (get $desktop "text_size") | quote }}
if [ -n "$text_size" ]; then
    shell_config="$HOME/.config/omarchy/shell.toml"
    current_size=""
    if [ -f "$shell_config" ]; then
        current_size="$(awk '
            /^[[:space:]]*\[/ { in_font = ($0 ~ /^[[:space:]]*\[font\]([[:space:]]|$)/); next }
            in_font && /^[[:space:]]*base-size[[:space:]]*=/ {
                v = $0
                sub(/^[^=]*=[[:space:]]*/, "", v)
                sub(/[[:space:]]*(#.*)?$/, "", v)
                print v
                exit
            }
        ' "$shell_config")"
    fi
    if [ "${current_size:-12}" = "$text_size" ]; then
        echo "Omarchy text size already ${text_size}px."
    else
        omarchy display text size "$text_size"
        echo "Omarchy text size set to ${text_size}px."
    fi
fi

# Web apps: only a launcher Omarchy's web app commands wrote is removed, so a
# same-named app installed some other way is left alone.
applications_dir="$HOME/.local/share/applications"
{{- range (default (list) (get $desktop "removed_webapps")) }}
if grep -qE '^Exec=.*(omarchy-launch-webapp|omarchy-webapp-handler)' "$applications_dir/{{ . }}.desktop" 2>/dev/null; then
    OMARCHY_REMOVE_NOTIFY=false omarchy webapp remove {{ . | quote }}
    echo "Removed the {{ . }} web app."
fi
{{- end }}

# About window: Omarchy sizes org.omarchy.about to hug fastfetch's output, but
# only while there is no ~/.config/fastfetch/config.jsonc; with the managed one
# in place its 920x480 float rule is all that is left. The rule lives in
# ~/.config/hypr/hyprland.lua, which Omarchy writes once at install and never
# refreshes, so it is edited in place: an existing About size rule is updated,
# otherwise one is appended.
{{- $aboutSize := default (list) (get $desktop "about_window_size") }}
{{- if eq (len $aboutSize) 2 }}
hypr_config="$HOME/.config/hypr/hyprland.lua"
about_rule='o.window("org.omarchy.about", { size = { {{ index $aboutSize 0 }}, {{ index $aboutSize 1 }} } })'
if [ ! -f "$hypr_config" ]; then
    echo "No ~/.config/hypr/hyprland.lua yet; the About window rule waits for the next apply after Omarchy writes it." >&2
elif grep -qF "$about_rule" "$hypr_config"; then
    echo "About window rule already {{ index $aboutSize 0 }}x{{ index $aboutSize 1 }}."
else
    if grep -q '^o\.window("org\.omarchy\.about", { size = ' "$hypr_config"; then
        sed -i "s|^o\.window(\"org\.omarchy\.about\", { size = {[^}]*} })|$about_rule|" "$hypr_config"
    else
        printf '\n%s\n%s\n%s\n' \
            '-- About window: a user fastfetch config turns off Omarchy'"'"'s auto-fit, so size it' \
            '-- to hold the logo plus the module columns at the current terminal font (chezmoi).' \
            "$about_rule" >> "$hypr_config"
    fi
    if pgrep -x Hyprland >/dev/null 2>&1; then
        hyprctl reload >/dev/null 2>&1 || true
    fi
    echo "About window rule set to {{ index $aboutSize 0 }}x{{ index $aboutSize 1 }}."
fi
{{- end }}

# Shell plugins: clone each missing one and enable it into its bar section.
# `omarchy plugin add` registers the clone with the running shell, so without
# one this waits for an apply from the desktop. A clone that fails (no network,
# a moved repository) is reported and the rest still run. Comes before the
# branding step so a freshly added Keystroke gets its glyph in the same run.
{{- $plugins := default (list) (get $desktop "plugins") }}
{{- if $plugins }}
plugins_dir="$HOME/.config/omarchy/plugins"

# omarchy plugin add rescans asynchronously; enabling before the shell knows
# the id fails with "not known", so poll the way the add command itself does.
wait_for_plugin() {
    local attempt
    for (( attempt = 0; attempt < 40; attempt++ )); do
        if omarchy-plugin-list --json 2>/dev/null | jq -e --arg id "$1" 'any(.[]; .id == $id)' >/dev/null 2>&1; then
            return 0
        fi
        sleep 0.05
    done
    return 1
}

if ! pgrep -x quickshell >/dev/null 2>&1; then
    echo "omarchy-shell is not running; run 'chezmoi apply' from the desktop to add the shell plugins." >&2
else
{{- range $plugins }}
    if [ -e "$plugins_dir/{{ .id }}" ]; then
        echo "Shell plugin {{ .id }} already installed."
    elif omarchy plugin add {{ .url | quote }} --yes && wait_for_plugin {{ .id | quote }} && omarchy plugin enable {{ .id | quote }}{{ with (get . "section") }} --section {{ . }}{{ end }}; then
        echo "Added shell plugin {{ .id }}."
    else
        echo "Could not add shell plugin {{ .id }} from {{ .url }}; add it by hand with: omarchy plugin add {{ .url }}" >&2
    fi
{{- end }}
fi
{{- end }}

# Branding in code: the Keystroke bar plugin (a clone of omarchy.menu) draws
# its menu button with the Omarchy glyph from Omarchy's icon font. Shell
# plugins are not managed here, so this only patches an installed copy, and
# the Nerd Font the bar already uses supplies the Arch Linux glyph (U+F303).
# `omarchy plugin update` can bring the Omarchy glyph back; a later apply
# after this file changes patches it again.
{{- if eq (default "" (get $desktop "branding")) "arch" }}
keystroke_widget="$HOME/.config/omarchy/plugins/evindor.keystroke/BarWidget.qml"
if [ -f "$keystroke_widget" ]; then
    patch_status=0
    python3 - "$keystroke_widget" <<'PY' || patch_status=$?
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as handle:
    text = handle.read()
old = '      text: ""\n      fontFamily: "omarchy"\n'
new = '      text: ""\n'
if old not in text:
    sys.exit(2 if new in text else 1)
with open(path, "w", encoding="utf-8") as handle:
    handle.write(text.replace(old, new, 1))
PY
    case $patch_status in
    0)
        if pgrep -x quickshell >/dev/null 2>&1; then
            omarchy restart shell >/dev/null 2>&1 || true
        fi
        echo "Keystroke bar button now shows the Arch glyph."
        ;;
    2) echo "Keystroke bar button already shows the Arch glyph." ;;
    *) echo "Keystroke's BarWidget.qml no longer has the expected button; swap its glyph by hand." >&2 ;;
    esac
else
    echo "Keystroke plugin not installed; nothing to rebrand on the bar."
fi
{{- end }}
{{ end -}}
