{{- if and (ne .chezmoi.os "windows") (not (env "GITHUB_ACTIONS")) (eq (default "personal" (get . "dotfiles_profile")) "personal") -}}
#!/bin/bash
set -euo pipefail
if command -v llmfit >/dev/null 2>&1; then
    exit 0
fi
if command -v brew >/dev/null 2>&1; then
    brew install AlexsJones/llmfit/llmfit || brew install llmfit
else
    # Pinned to a release tag so a compromised main branch cannot inject code here.
    curl -fsSL https://raw.githubusercontent.com/AlexsJones/llmfit/v1.1.10/install.sh | sh
fi
{{- end }}
