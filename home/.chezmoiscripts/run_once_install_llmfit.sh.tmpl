{{- if and (ne .chezmoi.os "windows") (not (env "GITHUB_ACTIONS")) (eq (default "personal" (get . "dotfiles_profile")) "personal") -}}
#!/bin/bash
set -euo pipefail
if command -v llmfit >/dev/null 2>&1; then
    exit 0
fi
if command -v brew >/dev/null 2>&1; then
    brew install AlexsJones/llmfit/llmfit || brew install llmfit
else
    # Upstream's installer, unpinned: it resolves the latest llmfit release at
    # run time (test/upstream_installers_latest.sh checks this).
    # --local installs to ~/.local/bin without sudo. Without it the installer
    # redirects a sudo prompt from /dev/tty, which fails (and aborts the script
    # under its set -e) when bootstrap runs without a controlling terminal.
    curl -fsSL https://raw.githubusercontent.com/AlexsJones/llmfit/main/install.sh | sh -s -- --local
fi
{{- end }}
