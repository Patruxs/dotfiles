{{- if ne .chezmoi.os "windows" -}}
#!/bin/bash
set -euo pipefail
if command -v zoxide >/dev/null 2>&1; then
    exit 0
fi
# Upstream's installer, unpinned: it resolves the latest zoxide release from
# the GitHub API at run time (test/upstream_installers_latest.sh checks this).
curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh
{{- end }}
