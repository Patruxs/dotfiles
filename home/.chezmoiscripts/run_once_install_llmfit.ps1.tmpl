{{- if and (eq .chezmoi.os "windows") (not (env "GITHUB_ACTIONS")) (eq (default "personal" (get . "dotfiles_profile")) "personal") -}}
if (-not (Get-Command llmfit -ErrorAction SilentlyContinue)) {
    if (Get-Command scoop -ErrorAction SilentlyContinue) {
        scoop install llmfit
        if (-not (Get-Command llmfit -ErrorAction SilentlyContinue)) {
            throw "scoop install llmfit did not provide the llmfit command"
        }
    } else {
        Write-Warning "scoop not found; skipping llmfit install."
    }
}
{{- end }}
