[include]
	# Identity generated by chezmoi from its config data.
	path = ~/.gitconfig.local
	# Hand-maintained per-machine settings; never managed by chezmoi.
	path = ~/.gitconfig.machine
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
