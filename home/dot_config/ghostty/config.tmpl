theme = Xcode Dark
# Omarchy: follow the active system theme when present (ignored elsewhere).
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"
window-theme = ghostty
window-height = 40
window-width = 140
background-opacity = 1
background-blur = false
font-family = JetBrainsMono Nerd Font
font-family-bold = JetBrainsMono Nerd Font
font-family-italic = JetBrainsMono Nerd Font
font-family-bold-italic = JetBrainsMono Nerd Font
{{- /* Omarchy scales terminals with `omarchy display text size` (12px shell == 9pt), and
       its sed on this file needs a plain file, which a template gives. */}}
font-size = {{ if default false (get . "omarchy") }}9{{ else }}12{{ end }}
window-decoration = server
confirm-close-surface = false

gtk-titlebar = false


keybind = ctrl+up=scroll_page_up
keybind = ctrl+down=scroll_page_down

window-padding-x = 6
window-padding-y = 4
window-padding-balance = true

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env
