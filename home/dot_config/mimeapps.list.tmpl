{{- /* Omarchy's stock defaults (/usr/share/omarchy/default/applications/mimeapps.list)
       with the browser swapped for Edge once the desktop_apps package is there.
       Links still route through hyprland-mimeapps.list to omarchy-launch-browser,
       which reads the default browser from here. A template so the target is a
       plain file: xdg-mime and browsers rewrite it, which would break a symlink. */ -}}
{{- $browser := "chromium.desktop" -}}
{{- if stat "/usr/bin/microsoft-edge-stable" }}{{ $browser = "microsoft-edge.desktop" }}{{ end -}}
[Default Applications]
inode/directory=org.gnome.Nautilus.desktop

image/png=imv.desktop
image/jpeg=imv.desktop
image/gif=imv.desktop
image/webp=imv.desktop
image/bmp=imv.desktop
image/tiff=imv.desktop

application/pdf=org.gnome.Evince.desktop

text/html={{ $browser }}
x-scheme-handler/http={{ $browser }}
x-scheme-handler/https={{ $browser }}
x-scheme-handler/about={{ $browser }}
x-scheme-handler/unknown={{ $browser }}
x-scheme-handler/mailto=HEY.desktop
x-scheme-handler/claude-cli=claude-code-url-handler.desktop

video/mp4=mpv.desktop
video/x-msvideo=mpv.desktop
video/x-matroska=mpv.desktop
video/x-flv=mpv.desktop
video/x-ms-wmv=mpv.desktop
video/mpeg=mpv.desktop
video/ogg=mpv.desktop
video/webm=mpv.desktop
video/quicktime=mpv.desktop
video/3gpp=mpv.desktop
video/3gpp2=mpv.desktop
video/x-ms-asf=mpv.desktop
video/x-ogm+ogg=mpv.desktop
video/x-theora+ogg=mpv.desktop
application/ogg=mpv.desktop

text/plain=nvim.desktop
text/english=nvim.desktop
text/x-makefile=nvim.desktop
text/x-c++hdr=nvim.desktop
text/x-c++src=nvim.desktop
text/x-chdr=nvim.desktop
text/x-csrc=nvim.desktop
text/x-java=nvim.desktop
text/x-moc=nvim.desktop
text/x-pascal=nvim.desktop
text/x-tcl=nvim.desktop
text/x-tex=nvim.desktop
application/x-shellscript=nvim.desktop
text/x-c=nvim.desktop
text/x-c++=nvim.desktop
application/xml=nvim.desktop
text/xml=nvim.desktop
