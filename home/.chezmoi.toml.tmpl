{{- $gitName := "CI User" -}}
{{- $gitEmail := "ci@example.com" -}}
{{- $gpgRecipient := env "CHEZMOI_GPG_RECIPIENT" -}}
{{- $manageSshConfig := false -}}
{{- $manageSshKeys := false -}}
{{- $dotfilesProfile := env "DOTFILES_PROFILE" -}}
{{- if not (or (env "DOTFILES_CI") (env "GITHUB_ACTIONS")) -}}
{{-   $gitName = promptStringOnce . "git.name" "Git user.name" "" -}}
{{-   $gitEmail = promptStringOnce . "git.email" "Git user.email" "" -}}
{{-   if not $gpgRecipient -}}
{{-     $gpgRecipient = promptStringOnce . "gpg_recipient" "GPG recipient (optional)" "" -}}
{{-   end -}}
{{-   $manageSshConfig = promptBoolOnce . "manage_ssh_config" "Apply the example SSH config" false -}}
{{-   $manageSshKeys = promptBoolOnce . "manage_ssh_keys" "Provision GitHub SSH keys from Bitwarden (requires the repo owner's vault items; on a fork, replace home/private_dot_ssh/ first)" false -}}
{{-   if not $dotfilesProfile -}}
{{-     $dotfilesProfile = promptStringOnce . "dotfiles_profile" "Dotfiles profile (personal or work)" "personal" -}}
{{-   end -}}
{{- end -}}
{{- if not $dotfilesProfile -}}
{{-   $dotfilesProfile = "personal" -}}
{{- end -}}
{{- $dotfilesProfile = lower $dotfilesProfile -}}
{{- if not (has $dotfilesProfile (list "personal" "work")) -}}
{{-   fail (printf "dotfiles_profile must be personal or work, got %q" $dotfilesProfile) -}}
{{- end -}}
mode = "symlink"
sourceDir = {{ .chezmoi.sourceDir | quote }}

{{ if $gpgRecipient }}
encryption = "gpg"
[gpg]
    recipient = {{ $gpgRecipient | quote }}
    args = ["--quiet"]
{{ end }}

[data]
    manage_ssh_config = {{ $manageSshConfig }}
    manage_ssh_keys = {{ $manageSshKeys }}
    dotfiles_profile = {{ $dotfilesProfile | quote }}
    gpg_recipient = {{ $gpgRecipient | quote }}

{{ if or $gitName $gitEmail }}
[data.git]
{{- if $gitName }}
    name = {{ $gitName | quote }}
{{- end }}
{{- if $gitEmail }}
    email = {{ $gitEmail | quote }}
{{- end }}
{{ end }}
