.env
.env.*
# Hand-maintained per-machine git settings; keep out of chezmoi entirely.
.gitconfig.machine
# Hand-maintained per-machine shell additions, sourced by ~/.profile.
.profile.local
.ssh/known_hosts*
# Guardrail: never manage (or accidentally `chezmoi add`) SSH keys, except the
# chezmoi-provisioned GitHub keys when manage_ssh_keys is enabled.
.ssh/id_*
.ssh/*.pub
{{ if and (default false (get . "manage_ssh_keys")) (lookPath "bw") (env "BW_SESSION") }}
!.ssh/id_ed25519_github
!.ssh/id_ed25519_github.pub
!.ssh/id_ed25519_github_personal
!.ssh/id_ed25519_github_personal.pub
!.ssh/id_ed25519_github_work
!.ssh/id_ed25519_github_work.pub
{{ end }}
{{ if not (default false (get . "manage_ssh_config")) }}
.ssh/config
{{ end }}
.docker/config.json
.config/gh/**
.config/Code/User/globalStorage/**
.config/Code/User/workspaceStorage/**
.config/Code/User/History/**
.config/Code/User/logs/**
.config/warp-terminal/user_preferences.json
.config/nvim/lazy-lock.json
.config/opencode/node_modules/**
.config/opencode/**/auth*
.config/opencode/**/session*
# Guardrail: display layout is machine state (and leaks hardware serials);
# never manage (or accidentally `chezmoi add`) it. GNOME keeps it in
# monitors.xml, KDE Plasma in kwinoutputconfig.json and kscreen/.
.config/monitors.xml
.config/monitors.xml~
.config/monitors.xml.bak-*
.config/kwinoutputconfig.json
.config/kscreen/**
.config/dconf/user
.config/org.gnome.Ptyxis/session.gvariant
# KDE rc files are rewritten atomically by KDE, which would replace a chezmoi
# symlink with a plain file. The ones scripts/kde-settings-sync.sh tracks are
# managed key by key from desktop_environment/kde/settings/ instead; the panel layout files are
# machine state tied to activity and screen identifiers.
.config/kdeglobals
.config/kwinrc
.config/kwinrulesrc
.config/kglobalshortcutsrc
.config/kxkbrc
.config/kcminputrc
.config/powerdevilrc
.config/knighttimerc
.config/kscreenlockerrc
.config/ksmserverrc
.config/plasma-localerc
.config/plasmarc
.config/plasmanotifyrc
.config/krunnerrc
.config/klipperrc
.config/dolphinrc
.config/konsolerc
.config/baloofilerc
.config/plasma-org.kde.plasma.desktop-appletsrc
.config/plasmashellrc

{{- $features := default (list) (get . "dotfiles_features") }}
{{- $desktop := default "none" (get . "dotfiles_desktop") }}
{{- if and (eq .chezmoi.os "linux") (not (get . "dotfiles_desktop")) }}
{{-   $desktop = default "none" (output "bash" (joinPath .chezmoi.sourceDir ".." "scripts" "detect-desktop.sh") | trim) }}
{{- end }}

{{- if not (has "mise" $features) }}
.config/mise
.config/mise/**
{{- else }}
{{-   range (glob (joinPath .chezmoi.sourceDir "dot_config" "mise" "conf.d" "*.toml")) }}
{{-     $feature := trimSuffix ".toml" (base .) }}
{{-     if not (has $feature $features) }}
.config/mise/conf.d/{{ $feature }}.toml
{{-     end }}
{{-   end }}
{{- end }}

{{- if or (ne .chezmoi.os "linux") (not (has "audio_auto_switch" $features)) }}
.local/bin/auto-headphone-switch
.config/systemd/user/auto-headphone-switch.service
{{- end }}

{{- if ne $desktop "kde" }}
.config/rofi/**
.local/share/rofi/**
.local/share/applications/omarchy-*.desktop
.local/bin/omarchy-pin-window
.local/bin/omarchy-show-battery
.local/bin/omarchy-show-time
{{- end }}

{{- if eq $desktop "kde" }}
{{-   if not (and (has "mise" $features) (has "ai_clis" $features) (has "ghostty_terminal" $features)) }}
.local/share/applications/omarchy-ai-agent.desktop
{{-   end }}
{{-   if not (has "desktop_apps" $features) }}
{{-     range (glob (joinPath $.chezmoi.sourceDir "dot_local" "share" "applications" "omarchy-*.desktop*")) }}
{{-       if regexMatch "com\\.microsoft\\.Edge|org\\.telegram\\.desktop|bin/spotify" (include .) }}
.local/share/applications/{{ trimSuffix ".tmpl" (base .) }}
{{-       end }}
{{-     end }}
{{-   end }}
{{- end }}

{{- if ne .chezmoi.os "linux" }}
.config/systemd/**
.config/user-dirs.dirs
.config/user-dirs.locale
.local/share/icons/dotfiles/**
.config/fontconfig/**
.local/bin/update-flatpak-wrappers
{{- end }}

{{- if ne .chezmoi.os "darwin" }}
Library
Library/**
{{- end }}

{{- if ne .chezmoi.os "windows" }}
AppData
AppData/**
Documents
Documents/**
{{- end }}

{{- if eq .chezmoi.os "windows" }}
.bashrc
.bash_profile
.profile
.zshrc
.tmux.conf
.config/ghostty
.config/ghostty/**
.config/herdr
.config/herdr/**
.config/nvim
.config/nvim/**
.config/zed
.config/zed/**
.config/powershell
.config/powershell/**
{{- end }}
