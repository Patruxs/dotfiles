# machine state tied to activity and screen identifiers.
.config/kdeglobals
.config/kwinrc
.config/kwinrulesrc
.config/kglobalshortcutsrc
.config/kxkbrc
.config/kcminputrc
.config/powerdevilrc
.config/knighttimerc
.config/kscreenlockerrc
.config/ksmserverrc
.config/plasma-localerc
.config/plasmarc
