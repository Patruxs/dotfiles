{{ if default false (get . "omarchy") }}
# Omarchy manages and themes tmux via ~/.config/tmux/tmux.conf; a ~/.tmux.conf
# would shadow it.
.tmux.conf
# Omarchy lays out the XDG user dirs itself (no Desktop, Templates or Public,
# a Projects dir) and xdg-user-dirs-update rewrites the file at login, which
# would replace a symlink.
.config/user-dirs.dirs
# Guardrail: the Hyprland monitor layout and scale is machine state, like
# monitors.xml on GNOME; never manage (or accidentally `chezmoi add`) it.
.config/hypr/monitors.lua
{{- $omarchyFeatures := default (list) (get . "dotfiles_features") }}
{{- if not (has "ghostty_terminal" $omarchyFeatures) }}
.config/xdg-terminals.list
{{- end }}
{{- if not (has "ai_clis" $omarchyFeatures) }}
.config/omarchy/defaults/agent
{{- end }}
{{ else }}
# The Omarchy desktop layer: fcitx5 with the Vietnamese unikey engine (Omarchy
# ships and wires fcitx5), its stock mimeapps with the browser swapped, the
# xdg-terminal-exec default, the default coding agent and the Nautilus
# bookmarks. Other desktops keep their own.
.config/fcitx5
.config/fcitx5/**
.config/mimeapps.list
.config/xdg-terminals.list
.config/omarchy
.config/omarchy/**
.config/gtk-3.0
.config/gtk-3.0/**
# The fastfetch config runs omarchy-* commands for its version lines.
.config/fastfetch
.config/fastfetch/**
{{ end }}
