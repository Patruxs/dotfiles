.config/plasmashellrc

{{- $features := default (list) (get . "dotfiles_features") }}
{{- $desktop := default "none" (get . "dotfiles_desktop") }}
{{- if and (eq .chezmoi.os "linux") (not (get . "dotfiles_desktop")) }}
{{-   $desktop = default "none" (output "bash" (joinPath .chezmoi.sourceDir ".." "scripts" "detect-desktop.sh") | trim) }}
{{- end }}

{{- if not (has "mise" $features) }}
.config/mise
.config/mise/**
{{- else }}
{{- /* Omarchy declares its own mise tools in ~/.config/mise/config.toml, and its
         launchers in ~/.local/bin run `mise use -g <tool>`, which refuses to run
         while a tool is declared in two global mise files. A list that overlaps is
         therefore not symlinked on Omarchy; .chezmoiscripts/run_onchange_after_30-
         omarchy-mise-lists.sh.tmpl writes it without the tools Omarchy already has. */ -}}
{{-   $omarchyMiseTools := dict }}
{{-   if default false (get . "omarchy") }}
{{-     $omarchyMiseConfig := joinPath .chezmoi.homeDir ".config" "mise" "config.toml" }}
{{-     if stat $omarchyMiseConfig }}
{{-       $omarchyMiseTools = default (dict) (get (include $omarchyMiseConfig | fromToml) "tools") }}
{{-     end }}
{{-   end }}
{{-   range (glob (joinPath .chezmoi.sourceDir "dot_config" "mise" "conf.d" "*.toml")) }}
{{-     $feature := trimSuffix ".toml" (base .) }}
{{-     $overlapsOmarchy := false }}
{{-     range $tool, $_ := default (dict) (get (include . | fromToml) "tools") }}
{{-       if hasKey $omarchyMiseTools $tool }}{{ $overlapsOmarchy = true }}{{ end }}
{{-     end }}
{{-     if or (not (has $feature $features)) $overlapsOmarchy }}
.config/mise/conf.d/{{ $feature }}.toml
{{-     end }}
{{-   end }}
{{- end }}

{{- if or (ne .chezmoi.os "linux") (not (has "audio_auto_switch" $features)) }}
.local/bin/auto-headphone-switch
.config/systemd/user/auto-headphone-switch.service
{{- end }}

{{- if or (ne .chezmoi.os "linux") (ne $desktop "kde") }}
.local/bin/ghostty
.local/share/applications/com.mitchellh.ghostty.desktop
.config/systemd/user/app-com.mitchellh.ghostty.service.d
.config/systemd/user/app-com.mitchellh.ghostty.service.d/**
{{- end }}

{{- if ne $desktop "kde" }}
.config/rofi/**
.local/share/rofi/**
.local/share/applications/omarchy-*.desktop
.local/bin/omarchy-pin-window
.local/bin/omarchy-show-battery
.local/bin/omarchy-show-time
{{- end }}

{{- if eq $desktop "kde" }}
{{-   if not (and (has "mise" $features) (has "ai_clis" $features) (has "ghostty_terminal" $features)) }}
.local/share/applications/omarchy-ai-agent.desktop
{{-   end }}
{{-   if not (has "desktop_apps" $features) }}
{{-     range (glob (joinPath $.chezmoi.sourceDir "dot_local" "share" "applications" "omarchy-*.desktop*")) }}
{{-       if regexMatch "com\\.microsoft\\.Edge|org\\.telegram\\.desktop|bin/spotify" (include .) }}
.local/share/applications/{{ trimSuffix ".tmpl" (base .) }}
{{-       end }}
{{-     end }}
{{-   end }}
{{- end }}

