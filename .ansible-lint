---
profile: moderate

kinds:
  - tasks: "ansible/playbooks/common.yml"
  - tasks: "ansible/playbooks/execution.yml"
  - tasks: "ansible/playbooks/feature_best_effort.yml"

exclude_paths:
  - home/
  - desktop_environment/
  - packages/
  - test/

skip_list:
  - var-naming[no-role-prefix]
  - role-name[path]
  - command-instead-of-module
