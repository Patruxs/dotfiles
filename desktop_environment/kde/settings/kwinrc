# KDE Plasma settings for ~/.config/kwinrc, captured by scripts/kde-settings-sync.sh.
#
# Regenerate with:   ./scripts/kde-settings-sync.sh capture
# Restore with:      ./scripts/kde-settings-sync.sh apply
#
# Values use KConfig's own escaping (a tab is \t, a backslash is \\).

[Desktops]
Number=6
Rows=1

[Effect-blur]
NoiseStrength=6

[ModifierOnlyShortcuts]
Meta=org.kde.plasmashell,/PlasmaShell,org.kde.PlasmaShell,activateLauncherMenu

[NightColor]
Active=true
NightTemperature=4700

[Plugins]
diminactiveEnabled=true
krohnkiteEnabled=true
slideEnabled=false
tileseditorEnabled=false

[Script-krohnkite]
binaryTreeLayoutOrder=1
columnsLayoutOrder=8
floatingLayoutOrder=10
monocleLayoutOrder=4
newWindowPosition=2
quarterLayoutOrder=6
screenGapBetween=10
screenGapBottom=10
screenGapLeft=10
screenGapRight=10
screenGapTop=10
spiralLayoutOrder=2
spreadLayoutOrder=9
stackedLayoutOrder=7
stairLayoutOrder=11
threeColumnLayoutOrder=5
tileLayoutOrder=3

[Wayland]
VirtualKeyboardMode=0

[Windows]
BorderSnapZone=0
CenterSnapZone=0
ElectricBorderMaximize=false
ElectricBorderTiling=false
WindowSnapZone=0

[org.kde.kdecoration2]
BorderSize=Tiny
BorderSizeAuto=false
library=org.kde.kwin.aurorae.v2
theme=__aurorae__svg__ActiveAccentFrame
